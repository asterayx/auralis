-- Production SQLite schema (SQLDelight). JVM tests use InMemorySessionRepository;
-- mobile targets wire this schema via SQLDelight drivers.

CREATE TABLE session (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    mode TEXT NOT NULL,
    status TEXT NOT NULL,
    created_at_ms INTEGER NOT NULL,
    updated_at_ms INTEGER NOT NULL,
    ended_at_ms INTEGER,
    language_json TEXT NOT NULL,
    keep_audio INTEGER NOT NULL DEFAULT 1,
    audio_path TEXT,
    audio_duration_ms INTEGER NOT NULL DEFAULT 0,
    folder TEXT,
    tags_json TEXT NOT NULL,
    profile_id TEXT,
    source_language TEXT,
    target_language TEXT
);

CREATE TABLE transcript_token (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    text TEXT NOT NULL,
    start_ms INTEGER NOT NULL,
    end_ms INTEGER NOT NULL,
    is_final INTEGER NOT NULL,
    speaker_id TEXT,
    language TEXT,
    confidence REAL,
    FOREIGN KEY(session_id) REFERENCES session(id) ON DELETE CASCADE
);

CREATE TABLE edit_overlay (
    session_id TEXT NOT NULL,
    segment_id TEXT NOT NULL,
    edited_text TEXT NOT NULL,
    edited_at_ms INTEGER NOT NULL,
    PRIMARY KEY(session_id, segment_id)
);

CREATE TABLE translation (
    session_id TEXT NOT NULL,
    segment_id TEXT NOT NULL,
    source_text TEXT NOT NULL,
    translated_text TEXT NOT NULL,
    is_preview INTEGER NOT NULL,
    provider_id TEXT NOT NULL,
    model TEXT NOT NULL,
    updated_at_ms INTEGER NOT NULL,
    PRIMARY KEY(session_id, segment_id)
);

CREATE TABLE post_process (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    template_id TEXT NOT NULL,
    template_name TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at_ms INTEGER NOT NULL,
    provider_id TEXT NOT NULL,
    model TEXT NOT NULL,
    input_tokens INTEGER NOT NULL,
    output_tokens INTEGER NOT NULL
);

CREATE VIRTUAL TABLE session_fts USING fts4(
    session_id,
    title,
    transcript,
    translation
);
