default_platform(:ios)

platform :ios do
  desc "Generate Xcode project and export a signed IPA"
  lane :ipa do |options|
    method = options[:export_method] || ENV["IOS_EXPORT_METHOD"] || "development"
    output = options[:output] || File.expand_path("../../dist/ios", __dir__)
    FileUtils.mkdir_p(output)

    Dir.chdir("..") do
      sh("xcodegen generate")
    end

    build_app(
      project: File.expand_path("../Auralis.xcodeproj", __dir__),
      scheme: "Auralis",
      sdk: "iphoneos",
      destination: "generic/platform=iOS",
      clean: true,
      export_method: method,
      output_directory: output,
      output_name: "Auralis.ipa",
      xcargs: "DEVELOPMENT_TEAM='#{ENV.fetch("DEVELOPMENT_TEAM")}'",
    )
  end
end
